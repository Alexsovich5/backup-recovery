# Passwords of the local test stack. `make env` copies this file to
# secrets/passwords.env (not tracked) and scripts/split-secrets.sh writes
# one file per service from it, so each container receives only the
# passwords it needs. Change the values there for anything other than the
# local test stack.

DIR_PASSWORD=change-me-director
FD_PASSWORD=change-me-client
SD_PASSWORD=change-me-storage
DB_PASSWORD=change-me-catalog
# Account "drill" of the catalog server: rights on bacula_drill only.
DRILL_DB_PASSWORD=change-me-drill-catalog
# drill-dir -> drill-fd (recovery File Daemon on the dr-client service).
DRFD_PASSWORD=change-me-recovery
# rsync daemon user "bacula" on the offsite host.
OFFSITE_PASSWORD=change-me-offsite
