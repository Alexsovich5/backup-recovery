# Values substituted into config/*.conf by scripts/render-config.sh.
# `make env` copies this file to config/bacula.env (not tracked); change the
# passwords there for anything other than the local test stack.

DIR_PASSWORD=change-me-director
FD_PASSWORD=change-me-client
SD_PASSWORD=change-me-storage
DB_PASSWORD=change-me-catalog
# drill-dir -> drill-fd (recovery File Daemon on the dr-client service).
DRFD_PASSWORD=change-me-recovery
# rsync daemon user "bacula" on the offsite host.
OFFSITE_PASSWORD=change-me-offsite

# Compose service names on the backupnet network.
DIR_HOST=director
SD_HOST=director
DB_HOST=catalog
FD_HOST=server01
SMTP_HOST=smtp
DRFD_HOST=dr-client

ADMIN_EMAIL=backup-admin@localhost

# PKI key directory; the client and dr-client entrypoints override it with
# their own key volume (/etc/bacula/keys and /etc/bacula/keysafe).
KEY_DIR=/src/build/keys
# Directory holding the scripts named in Run*Job directives.
SCRIPT_DIR=/src/scripts
