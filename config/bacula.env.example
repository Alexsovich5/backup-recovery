# Values substituted into config/*.conf by scripts/render-config.sh.
# `make env` copies this file to config/bacula.env (not tracked). It holds
# no password: those live in secrets/passwords.env (see
# config/passwords.env.example) and reach each service as its own file.

# Compose service names on the backupnet network.
DIR_HOST=director
SD_HOST=director
DB_HOST=catalog
FD_HOST=server01
SMTP_HOST=smtp
DRFD_HOST=dr-client
# Host of the scratch Storage Daemon that dr-drill.sh starts (the drill
# service, the only host that shares a network with dr-client).
DRILL_SD_HOST=drill

ADMIN_EMAIL=backup-admin@localhost

# PKI key directory; the client and dr-client entrypoints override it with
# their own key volume (/etc/bacula/keys and /etc/bacula/keysafe).
KEY_DIR=/src/build/keys
# Directory holding the scripts named in Run*Job directives.
SCRIPT_DIR=/src/scripts
